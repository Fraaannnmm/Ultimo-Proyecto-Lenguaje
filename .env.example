# =========================================================
#  ReservaUJAP — Variables de entorno
#  Copia este archivo como .env y cambia los valores:
#      cp .env.example .env
#  El archivo .env NO se sube a GitHub (esta en .gitignore)
# =========================================================

# ---------- PostgreSQL ----------
DB_USER=ujap_admin
DB_PASS=cambia-esta-clave-postgres
DB_NAME=reservaujap

# ---------- MongoDB ----------
MONGO_USER=ujap_mongo
MONGO_PASS=cambia-esta-clave-mongo
MONGO_DB=catalogo

# ---------- JWT (servicio Python emite, Node lo verifica) ----------
# Genera una con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esta-clave-jwt-por-una-de-64-caracteres-aleatorios
TOKEN_EXPIRY_MIN=120

# ---------- Clave interna (Java -> Go) ----------
INTERNAL_API_KEY=cambia-esta-clave-interna

# ---------- Usuarios de prueba creados al arrancar ----------
SEED_PASSWORD=ujap2026

# ---------- Zona horaria de las reservas ----------
APP_TIMEZONE=America/Caracas

# ---------- Puerto publico del API Gateway ----------
GATEWAY_PORT=80
